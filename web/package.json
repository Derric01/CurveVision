{
  "name": "curvevision-web",
  "version": "1.0.0",
  "homepage": "https://github.com/Derric01/CurveVision#download-the-desktop-application",
  "private": true,
  "type": "module",
  "description": "CurveVision web application and annotation editor",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run --reporter=verbose"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.0",
    "@tauri-apps/api": "^2.11.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.417.0",
    "rbush": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/rbush": "^4.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
