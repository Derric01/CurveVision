# CurveVision configuration. Copy to .env and edit before `docker compose up`.
# Every variable the server reads is listed here; there are no hidden defaults in code
# that a self-hoster has to discover from a stack trace.

# --- required -----------------------------------------------------------------------
# Signs access and refresh tokens. The server refuses to start in production without it.
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
CURVEVISION_SECRET_KEY=

# --- deployment ---------------------------------------------------------------------
CURVEVISION_ENVIRONMENT=production
WEB_PORT=8080
API_WORKERS=2
WORKER_PROCESSES=2
WORKER_THREADS=4

# Browser origins allowed to call the API. Never "*": the API accepts credentials.
CURVEVISION_CORS_ORIGINS=http://localhost:8080

# --- database -----------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-in-production

# --- object storage -----------------------------------------------------------------
MINIO_ROOT_USER=curvevision
MINIO_ROOT_PASSWORD=change-me-in-production
MINIO_CONSOLE_PORT=9001
CURVEVISION_S3_BUCKET=curvevision

# Point these at AWS S3, Cloudflare R2, Ceph or Backblaze instead of MinIO if you prefer.
# CURVEVISION_S3_ENDPOINT_URL=https://s3.eu-west-1.amazonaws.com
# CURVEVISION_S3_REGION=eu-west-1

# --- media --------------------------------------------------------------------------
# Frames per delivered chunk. The browser fetches chunks, never one request per frame.
CURVEVISION_FRAMES_PER_CHUNK=36
CURVEVISION_MAX_UPLOAD_BYTES=5368709120

# --- policy -------------------------------------------------------------------------
# Set false on a private instance once your accounts exist.
CURVEVISION_ALLOW_REGISTRATION=true
CURVEVISION_PASSWORD_MIN_LENGTH=10
CURVEVISION_RATE_LIMIT_PER_MINUTE=600

# --- observability ------------------------------------------------------------------
CURVEVISION_LOG_LEVEL=INFO
CURVEVISION_LOG_FORMAT=json
CURVEVISION_METRICS_ENABLED=true
