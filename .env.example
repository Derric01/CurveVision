# CurveVision configuration. Copy to .env and edit before `docker compose up`.
# Every variable the server reads is listed here; there are no hidden defaults in code
# that a self-hoster has to discover from a stack trace.

# --- required -----------------------------------------------------------------------
# Signs access and refresh tokens. The server refuses to start in production without it.
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
CURVEVISION_SECRET_KEY=

# --- deployment ---------------------------------------------------------------------
CURVEVISION_ENVIRONMENT=production
WEB_PORT=8080
API_WORKERS=2
WORKER_PROCESSES=2
WORKER_THREADS=4

# Browser origins allowed to call the API. Never "*": the API accepts credentials.
CURVEVISION_CORS_ORIGINS=http://localhost:8080

# --- database -----------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-in-production

# --- object storage -----------------------------------------------------------------
# The keys of the bundled S3 service (`s3`, Versity Gateway). An .env from before October
# 2026 that sets MINIO_ROOT_USER / MINIO_ROOT_PASSWORD instead still works.
S3_ACCESS_KEY=curvevision
S3_SECRET_KEY=change-me-in-production
CURVEVISION_S3_BUCKET=curvevision

# Point these at AWS S3, Cloudflare R2, Ceph or Backblaze instead of the bundled service if
# you prefer (and set S3_ACCESS_KEY / S3_SECRET_KEY to that service's keys).
# CURVEVISION_S3_ENDPOINT_URL=https://s3.eu-west-1.amazonaws.com
# CURVEVISION_S3_REGION=eu-west-1
# Where browsers can reach the store, to fetch media from it directly by presigned URL
# rather than through the API (the bucket must allow this application's origin by CORS):
# CURVEVISION_S3_PUBLIC_ENDPOINT_URL=https://s3.eu-west-1.amazonaws.com

# --- media --------------------------------------------------------------------------
# Frames per delivered chunk. The browser fetches chunks, never one request per frame.
CURVEVISION_FRAMES_PER_CHUNK=36
CURVEVISION_MAX_UPLOAD_BYTES=5368709120

# --- policy -------------------------------------------------------------------------
# Set false on a private instance once your accounts exist.
CURVEVISION_ALLOW_REGISTRATION=true
CURVEVISION_PASSWORD_MIN_LENGTH=10
CURVEVISION_RATE_LIMIT_PER_MINUTE=600
# memory (one process) or redis (shared by every replica; the compose default).
# CURVEVISION_RATE_LIMIT_BACKEND=redis

# --- malware scanning (docs/OPERATIONS.md) -------------------------------------------
# none, or clamd — with `docker compose --profile scanning up -d`.
# CURVEVISION_CONTENT_SCANNER=clamd
# CURVEVISION_CONTENT_SCANNER_FAIL_OPEN=false

# --- observability ------------------------------------------------------------------
CURVEVISION_LOG_LEVEL=INFO
CURVEVISION_LOG_FORMAT=json
CURVEVISION_METRICS_ENABLED=true
# OpenTelemetry tracing to an OTLP/HTTP collector (docs/OPERATIONS.md#tracing).
# CURVEVISION_TRACING_ENABLED=true
# CURVEVISION_TRACING_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
# CURVEVISION_TRACING_SAMPLE_RATIO=1.0
